<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barista Coffee Chatbot</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .chat-container {
            background: white;
            width: 100%;
            max-width: 500px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(135deg, #6f4e37 0%, #8b6914 100%);
            color: white;
            padding: 25px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 28px;
            margin-bottom: 5px;
        }
        
        .header p {
            opacity: 0.9;
            font-size: 14px;
        }
        
        .chat-box {
            height: 400px;
            overflow-y: auto;
            padding: 20px;
            background: #f8f9fa;
        }
        
        .message {
            margin-bottom: 15px;
            display: flex;
            align-items: flex-end;
            animation: slideIn 0.3s ease;
        }
        
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .message.user {
            justify-content: flex-end;
        }
        
        .message.bot {
            justify-content: flex-start;
        }
        
        .bubble {
            max-width: 75%;
            padding: 12px 18px;
            border-radius: 20px;
            font-size: 15px;
            line-height: 1.4;
        }
        
        .message.user .bubble {
            background: #6f4e37;
            color: white;
            border-bottom-right-radius: 5px;
        }
        
        .message.bot .bubble {
            background: white;
            color: #333;
            border-bottom-left-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            margin: 0 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }
        
        .input-area {
            display: flex;
            padding: 20px;
            background: white;
            border-top: 1px solid #eee;
        }
        
        input {
            flex: 1;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 25px;
            outline: none;
            font-size: 15px;
            transition: border-color 0.3s;
        }
        
        input:focus {
            border-color: #6f4e37;
        }
        
        button {
            margin-left: 10px;
            padding: 15px 25px;
            background: #6f4e37;
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 15px;
            transition: transform 0.2s, background 0.3s;
        }
        
        button:hover {
            background: #5a3e2b;
            transform: scale(1.05);
        }
        
        .typing {
            display: none;
            padding: 10px 20px;
            color: #999;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="chat-container">
        <div class="header">
            <h1>☕ Barista Bot</h1>
            <p>Your personal coffee assistant</p>
        </div>
        
        <div class="chat-box" id="chatBox">
            <div class="message bot">
                <div class="avatar">🤖</div>
                <div class="bubble">Hello! I'm your virtual barista. What can I get started for you today? Try asking about our coffee menu!</div>
            </div>
        </div>
        
        <div class="typing" id="typing">Barista is typing...</div>
        
        <div class="input-area">
            <input type="text" id="userInput" placeholder="Type your message..." autocomplete="off">
            <button onclick="sendMessage()">Send</button>
        </div>
    </div>

    <script>
        const chatBox = document.getElementById('chatBox');
        const userInput = document.getElementById('userInput');
        const typing = document.getElementById('typing');

        // Allow Enter key to send
        userInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') sendMessage();
        });

        function sendMessage() {
            const message = userInput.value.trim();
            if (!message) return;

            // Add user message
            addMessage(message, 'user');
            userInput.value = '';

            // Show typing indicator
            typing.style.display = 'block';
            chatBox.scrollTop = chatBox.scrollHeight;

            // Bot response after delay
            setTimeout(() => {
                typing.style.display = 'none';
                const response = getBotResponse(message);
                addMessage(response, 'bot');
            }, 1000);
        }

        function addMessage(text, sender) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;
            
            const avatar = sender === 'user' ? '👤' : '🤖';
            const bubbleColor = sender === 'user' ? 'user' : 'bot';
            
            messageDiv.innerHTML = `
                ${sender === 'bot' ? `<div class="avatar">${avatar}</div>` : ''}
                <div class="bubble">${text}</div>
                ${sender === 'user' ? `<div class="avatar">${avatar}</div>` : ''}
            `;
            
            chatBox.appendChild(messageDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function getBotResponse(input) {
            const text = input.toLowerCase();
            
            // Greetings
            if (text.includes('hello') || text.includes('hi') || text.includes('hey')) {
                return "Hey there! ☕ Ready to order some amazing coffee? We have Espresso, Latte, Cappuccino, and more!";
            }
            
            // Coffee types
            if (text.includes('espresso')) {
                return "Espresso - the pure essence of coffee! Would you like a single or double shot?";
            }
            if (text.includes('latte')) {
                return "Great choice! Our lattes are creamy and smooth. Hot or iced? And any flavor syrup?";
            }
            if (text.includes('cappuccino')) {
                return "Cappuccino - perfect balance of espresso, steamed milk, and foam! Would you like it dry or wet?";
            }
            if (text.includes('americano')) {
                return "Americano - bold and black! Would you like room for cream?";
            }
            if (text.includes('mocha')) {
                return "Mocha - chocolate meets coffee! Whipped cream on top?";
            }
            
            // Menu
            if (text.includes('menu') || text.includes('what do you have') || text.includes('options')) {
                return "Here's our menu: ☕ Espresso, 🥛 Latte, ☁️ Cappuccino, 🧊 Americano, 🍫 Mocha, and 🧋 Frappuccino. What sounds good?";
            }
            
            // Sizes
            if (text.includes('size') || text.includes('large') || text.includes('small') || text.includes('medium')) {
                return "We have Tall (small), Grande (medium), and Venti (large). Which size would you prefer?";
            }
            
            // Order complete
            if (text.includes('thank') || text.includes('thanks') || text.includes('perfect') || text.includes('great')) {
                return "You're welcome! Your order will be ready shortly. Enjoy your coffee! ☕";
            }
            
            // Default
            return "I'm not sure I understood. Would you like to see our menu or ask about a specific coffee?";
        }
    </script>
</body>
</html>
